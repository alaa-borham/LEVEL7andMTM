+.l7-design-bar .redo-command svg{transform:scaleX(-1)}
+body.ui-dark .l7-design-bar{background:#161b22;border-color:#2b333d}
+body.ui-dark .l7-design-bar [data-l7d-command="save"] svg{stroke:#5ccf73;color:#5ccf73}
+body.ui-dark .l7-design-bar [data-l7d-command="tab-x"] .palette-letter,body.ui-dark .l7-design-bar [data-l7d-command="tab-z"] .palette-letter{color:#6fd39a}
+.l7-design-stage iframe{min-height:0}
+.l7-design-bar .palette-command svg{color:#176a91}
+body.ui-dark .l7-design-bar .palette-command svg{color:#7cc4ef;stroke:#7cc4ef}
+body.ui-dark .l7-design-bar .palette-command small{color:#aab6c4}
+.l7-design-bar .palette-command[aria-pressed="true"]{background:#d7e9f4;box-shadow:inset 0 -2px #1b7fc0}
+body.ui-dark .l7-design-bar .palette-command[aria-pressed="true"]{background:#1f3d5c;box-shadow:inset 0 -2px #3d9bff}
