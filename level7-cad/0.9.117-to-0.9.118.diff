+/* 0.9.118 LEVEL7 design mode: engine frame + palette drawn with the host icons. */
+.work-area{position:relative}
+.l7-design{position:absolute;inset:0;z-index:30;display:grid;grid-template-columns:minmax(0,1fr) 264px;direction:ltr;background:var(--l7-bg,#f3f5f7)}
+.l7-design-palette{direction:rtl}
+body.l7-design-on #toolbox-dock{display:none}
+.l7-design[hidden]{display:none}
+.l7-design-stage{min-width:0;min-height:0;display:flex}
+.l7-design-stage iframe{flex:1;border:0;width:100%;height:100%;background:#fff}
+.l7-design-palette{display:flex;flex-direction:column;min-height:0;overflow:hidden;border-right:1px solid #b9c5ce;background:#eef2f5;padding:8px;gap:8px}
+.l7-design-palette header{display:flex;align-items:center;justify-content:space-between}
+.l7-design-palette header strong{font-size:13px;color:#16486a}
+.l7-design-palette header button{width:28px;min-height:26px;padding:0;font-size:18px;line-height:1}
+.l7-design-tools{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:4px;align-content:start;flex:1;min-height:0;overflow:hidden}
+.l7-design-tools h3{grid-column:1/-1;margin:4px 2px 0;font-size:10px;font-weight:600;color:#5b7488}
+.l7-design-tool,.l7-design-cmd{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;min-width:0;height:var(--l7d-card,62px);padding:4px 2px;border:1px solid #c3d0da;border-radius:7px;background:linear-gradient(#fbfcfd,#eaf0f4);color:#1d4a68;cursor:pointer}
+.l7-design-tool svg,.l7-design-cmd svg{width:var(--l7d-icon,34px);height:var(--l7d-icon,34px);flex:none;fill:none;stroke:#3a4b5a;stroke-width:2.3;stroke-linecap:round;stroke-linejoin:round;filter:drop-shadow(0 1.2px 1px rgba(11,35,56,.28))}
+.l7-design svg .ink{stroke:#3a4b5a;fill:none}.l7-design svg .blue{stroke:#1593d0;fill:none}.l7-design svg .dot{fill:#173d5a;stroke:#173d5a}
+.l7-design svg .l7-fill-fabric{fill:url(#l7-fabric)}.l7-design svg .l7-fill-sky{fill:url(#l7-sky)}
+.l7-design svg text{font-family:Arial,sans-serif;stroke:none;fill:currentColor}
+.l7-design-tool span,.l7-design-cmd span{font-size:9.5px;line-height:1.2;text-align:center;overflow:hidden;text-overflow:ellipsis;max-width:100%;white-space:nowrap}
+.l7-design-tool:hover,.l7-design-cmd:hover{border-color:#3b8fc4;box-shadow:0 2px 6px rgba(20,70,110,.18)}
+.l7-design-tool[aria-pressed="true"]{border-color:#1b7fc0;background:linear-gradient(#dff0fb,#bfdff3);box-shadow:inset 0 0 0 1px #1b7fc0}
+.l7-design-commands{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:4px}
+.l7-design-cmd{height:44px}.l7-design-cmd svg{width:22px;height:22px}.l7-design-cmd span{font-size:8.5px}
+.l7-flip svg{transform:scaleX(-1)}
